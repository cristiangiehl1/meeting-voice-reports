# Porta do backend. Default 4310 (fora da faixa 3000/8000, que costuma colidir com outros
# projetos rodando em paralelo no mesmo host).
PORT=4310

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Geração do relatório
# Alternativas: openai/gpt-5-nano, deepseek/deepseek-v4.1-flash
# Free p/ prototipar: openrouter/free
OPENROUTER_MODEL=openai/gpt-5.6-luna

LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=meeting-voice-reports

# Envio do relatório por email (Resend)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=
REPORT_EMAIL_TO=
